# =============================================================================
# Configuracao do github-namespace-scanner
# Copie este arquivo para `.env` e preencha os valores.
# =============================================================================

# Token de acesso ao GitHub. OBRIGATORIO.
#   - PAT Classic: precisa do escopo `repo`.
#   - PAT Fine-grained: precisa das permissoes
#       * Repository -> Variables: Read
#       * Repository -> Metadata: Read
GITHUB_TOKEN=

# Organizacao a ser varrida. OBRIGATORIO (pode ser sobrescrito por --org).
GITHUB_ORG=minha-org

# Base da API. OPCIONAL. Default: https://api.github.com
# Para GitHub Enterprise Server use: https://<host>/api/v3
GITHUB_API_URL=https://api.github.com

# Lista de topics separada por virgula. OBRIGATORIO (pode ser sobrescrito por --topics).
# O filtro e AND: o repo so entra se contiver TODOS os topics abaixo.
TOPICS=backstage,openshift

# Nome exato da Actions Repository Variable a ler. OPCIONAL. Default: NAMESPACE
VAR_NAME=NAMESPACE
