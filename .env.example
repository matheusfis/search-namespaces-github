# Copie para .env. Nunca faça commit do arquivo .env preenchido.

# Personal Access Token. Para PAT classic, use repo e read:org quando aplicável.
GITHUB_TOKEN=

# Caminho opcional para um certificado CA X.509 (PEM/DER) confiável no ambiente corporativo.
GITHUB_API_CERT_PATH=

# Proxy corporativo opcional. Exemplo: http://proxy.empresa.com:8080
PROXY_URL=

# Hosts que ignoram o proxy, separados por vírgula.
NO_PROXY=localhost,127.0.0.1

# Organização consultada. Pode ser sobrescrita por --org.
GITHUB_ORG=minha-org

# Tópicos separados por vírgula. O filtro usa lógica AND. Pode ser sobrescrito por --topics.
TOPICS=backstage,openshift

# URL base opcional. Para GitHub Enterprise Server: https://host/api/v3
GITHUB_API_URL=https://api.github.com

# Nome exato e case-sensitive da Actions Repository Variable.
VAR_NAME=NAMESPACE
